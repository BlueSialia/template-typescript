{
  "name": "typescript-project",
  "version": "0.1.0",
  "description": "A TypeScript library.",
  "type": "module",
  "license": "LicenseRef-Hippocratic-3.0",
  "author": "Jorge Domínguez Arnáez",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "knip": "knip",
    "test": "node --test",
    "test:unit": "node --test --experimental-test-tag-filter='unit'",
    "test:integration": "node --test --experimental-test-tag-filter='integration'",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run knip && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "knip": "^6.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
